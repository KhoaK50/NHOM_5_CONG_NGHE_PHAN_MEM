        <!-- ========================================================================= -->
        <!-- POOL 3: QUẢN TRỊ VIÊN (ADMIN MODERATOR) -->
        <!-- ========================================================================= -->
        <mxCell id="pool_admin" value="QUẢN TRỊ VIÊN (ADMIN)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=45;fillColor=#FDE68A;swimlaneFillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="60" y="685" width="1500" height="260" as="geometry" />
        </mxCell>

        <!-- Message Start Event: Vòng tròn đơn viền mảnh + Phong bì trắng -->
        <mxCell id="adm_start_msg" value="Tiếp nhận hồ sơ&#xa;Moderation Queue" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.8;fontSize=10;fontStyle=1;fontColor=#92400E;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=4;" vertex="1" parent="pool_admin">
          <mxGeometry x="652" y="102" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="icon_adm_start" value="" style="shape=message;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.1;pointerEvents=0;" vertex="1" parent="adm_start_msg">
          <mxGeometry x="9" y="12" width="18" height="12" as="geometry" />
        </mxCell>

        <!-- User Task 4: Xem trước toàn văn & Thẩm định 8 tiêu chí -->
        <mxCell id="adm_act_review" value="4. Xem trước toàn văn &amp;&#xa;Thẩm định 8 tiêu chí (UC09)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontColor=#0F172A;spacingLeft=10;" vertex="1" parent="pool_admin">
          <mxGeometry x="740" y="90" width="175" height="60" as="geometry" />
        </mxCell>
        <mxCell id="icon_adm_review" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=none;strokeColor=#D97706;strokeWidth=1.2;pointerEvents=0;" vertex="1" parent="adm_act_review">
          <mxGeometry x="8" y="6" width="10" height="15" as="geometry" />
        </mxCell>

        <!-- Exclusive Gateway (X) -->
        <mxCell id="adm_gw_decision" value="X" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#92400E;" vertex="1" parent="pool_admin">
          <mxGeometry x="945" y="95" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- User Task: Từ chối (REJECTED) & Nhập lý do phản hồi -->
        <mxCell id="adm_act_reject" value="Từ chối (REJECTED)&#xa;&amp; Nhập lý do phản hồi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.5;fontSize=11;fontColor=#991B1B;spacingLeft=10;" vertex="1" parent="pool_admin">
          <mxGeometry x="1030" y="28" width="165" height="55" as="geometry" />
        </mxCell>
        <mxCell id="icon_adm_reject" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=none;strokeColor=#EF4444;strokeWidth=1.2;pointerEvents=0;" vertex="1" parent="adm_act_reject">
          <mxGeometry x="8" y="6" width="10" height="15" as="geometry" />
        </mxCell>

        <!-- None End Event (Đã từ chối): Vòng tròn đơn VIỀN DÀY ĐẬM (strokeWidth=4) -->
        <mxCell id="adm_end_reject" value="Đã từ chối" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=4;fontSize=10;fontStyle=1;fontColor=#DC2626;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=3;" vertex="1" parent="pool_admin">
          <mxGeometry x="1230" y="37" width="36" height="36" as="geometry" />
        </mxCell>

        <!-- User Task: Phê duyệt (APPROVED) & Cho phép công khai -->
        <mxCell id="adm_act_approve" value="Phê duyệt (APPROVED)&#xa;&amp; Cho phép công khai" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11;fontColor=#166534;spacingLeft=10;" vertex="1" parent="pool_admin">
          <mxGeometry x="1220" y="155" width="165" height="55" as="geometry" />
        </mxCell>
        <mxCell id="icon_adm_approve" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=none;strokeColor=#16A34A;strokeWidth=1.2;pointerEvents=0;" vertex="1" parent="adm_act_approve">
          <mxGeometry x="8" y="6" width="10" height="15" as="geometry" />
        </mxCell>

        <!-- None End Event (Đã phê duyệt): Vòng tròn đơn VIỀN DÀY ĐẬM (strokeWidth=4) -->
        <mxCell id="adm_end_approve" value="Đã phê duyệt" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=4;fontSize=10;fontStyle=1;fontColor=#166534;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=3;" vertex="1" parent="pool_admin">
          <mxGeometry x="1425" y="164" width="36" height="36" as="geometry" />
        </mxCell>

        <!-- Sequence Flows trong Pool 3 -->
        <mxCell id="seq_adm1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#1E293B;strokeWidth=1.5;" edge="1" parent="pool_admin" source="adm_start_msg" target="adm_act_review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seq_adm2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#1E293B;strokeWidth=1.5;" edge="1" parent="pool_admin" source="adm_act_review" target="adm_gw_decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seq_adm_rej" value="[Từ chối]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#DC2626;labelBackgroundColor=#FFFBEB;" edge="1" parent="pool_admin" source="adm_gw_decision" target="adm_act_reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seq_adm_rej_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#1E293B;strokeWidth=1.5;" edge="1" parent="pool_admin" source="adm_act_reject" target="adm_end_reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seq_adm_app" value="[Duyệt]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#166534;labelBackgroundColor=#FFFBEB;" edge="1" parent="pool_admin" source="adm_gw_decision" target="adm_act_approve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seq_adm_app_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#1E293B;strokeWidth=1.5;" edge="1" parent="pool_admin" source="adm_act_approve" target="adm_end_approve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========================================================================= -->
        <!-- MESSAGE FLOWS (ĐƯỜNG NÉT ĐỨT LIÊN POOL - CHUẨN OMG BPMN 2.0 startArrow=oval) -->
        <!-- ========================================================================= -->
        <mxCell id="msg_submit" value="Gửi tệp PDF &amp; Metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;startArrow=oval;startFill=0;endArrow=open;endFill=0;strokeColor=#0284C7;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#0284C7;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_act_submit" target="sys_start_msg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="msg_err_report" value="Báo lỗi trùng SHA-256 / hỏng file" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;startArrow=oval;startFill=0;endArrow=open;endFill=0;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sys_act_reject" target="s_act_err">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="msg_pending_receipt" value="Biên nhận PENDING" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;startArrow=oval;startFill=0;endArrow=open;endFill=0;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#166534;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sys_act_pending" target="s_act_pending">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="msg_to_admin" value="Hàng đợi Moderation Queue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.12;exitY=1;entryX=0.5;entryY=0;dashed=1;startArrow=oval;startFill=0;endArrow=open;endFill=0;strokeColor=#D97706;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#92400E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sys_act_pending" target="adm_start_msg">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="665" />
              <mxPoint x="730" y="665" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg_adm_rej" value="Kết quả thẩm định &amp; Lý do" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=0;entryX=0.35;entryY=1;dashed=1;startArrow=oval;startFill=0;endArrow=open;endFill=0;strokeColor=#D97706;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#92400E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="adm_act_reject" target="sys_catch_admin">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1130" y="665" />
              <mxPoint x="1075" y="665" />
