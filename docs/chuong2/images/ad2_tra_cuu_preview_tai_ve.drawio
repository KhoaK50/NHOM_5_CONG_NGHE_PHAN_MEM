        <mxCell id="u_act1" value="1. Nhập từ khóa tìm kiếm &amp;&#xa;Chọn bộ lọc môn học / học kỳ (UC05)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;" vertex="1" parent="swimlane_user">
