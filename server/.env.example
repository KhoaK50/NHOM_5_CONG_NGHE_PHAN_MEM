# Sao chép thành server/.env rồi điền giá trị thật. Không commit file .env.
NODE_ENV=development
PORT=5000

# Supabase: Project Settings > Database > Connection string (URI, dùng Session pooler)
DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/fiveshare

# Sinh ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<RANDOM_SECRET>

# Danh sách origin frontend được phép gọi API, ngăn cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Số proxy phía trước server, ví dụ Render là 1. Bỏ trống khi chạy local.
TRUST_PROXY_HOPS=

# Cloudinary (Lưu trữ ảnh đại diện người dùng - UC01 / FR-02)
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_API_SECRET>
